"use client";
import {useEffect,useState,use} from "react";
import {getRecipe,Recipe,API,api} from "@/lib/api";
import {accessToken} from "@/lib/supabase";
const conversions:Record<string,{unit:string,factor:number}>={g:{unit:"oz",factor:1/28.3495},oz:{unit:"g",factor:28.3495},ml:{unit:"fl oz",factor:1/29.5735},"fl oz":{unit:"ml",factor:29.5735},tbsp:{unit:"tsp",factor:3},tsp:{unit:"tbsp",factor:1/3}};
export default function RecipePage({params}:{params:Promise<{id:string}>}){const {id}=use(params);const [recipe,setRecipe]=useState<Recipe|null>(null);const [servings,setServings]=useState(2);const [converted,setConverted]=useState(false);const [pantry,setPantry]=useState("");const [question,setQuestion]=useState("");const [answer,setAnswer]=useState("");const [status,setStatus]=useState("");const [loading,setLoading]=useState(false);
useEffect(()=>{getRecipe(id).then(r=>{setRecipe(r);setServings(r.servings)}).catch(e=>setStatus(e.message))},[id]);
async function save(){try{await api(`/me/saved/${id}`,await accessToken(),"POST");setStatus("Recipe saved!")}catch(e){setStatus(String(e))}}
async function addMissing(){if(!recipe)return;try{const token=await accessToken();const have=new Set(pantry.toLowerCase().split(",").map(x=>x.trim()));let count=0;for(const ing of recipe.ingredients){if(!have.has(ing.name.toLowerCase())){await api("/me/shopping",token,"POST",{name:ing.name,quantity:Number((ing.quantity*servings/recipe.servings).toFixed(2)),unit:ing.unit});count++}}setStatus(`${count} missing ingredients added to shopping list`)}catch(e){setStatus(String(e))}}
async function ask(){setLoading(true);setStatus("");try{const r=await fetch(`${API}/ai/ask`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question,recipe_title:recipe?.title||""})});if(!r.ok)throw Error(await r.text());setAnswer((await r.json()).answer)}catch(e){setStatus(`AI assistant: ${String(e)}`)}finally{setLoading(false)}}
if(!recipe)return <p>{status||"Loading recipe..."}</p>;
return <div className="grid lg:grid-cols-[2fr_1fr] gap-7"><div><p className="text-amber-400">{recipe.cuisine} · {recipe.minutes} minutes</p><h1 className="text-4xl font-bold my-4">{recipe.title}</h1><button className="secondary mb-5" onClick={save}>♡ Save recipe</button><section className="panel"><div className="flex flex-wrap gap-4 items-center justify-between"><h2 className="text-2xl font-bold">Ingredients</h2><label>Servings <input aria-label="Servings" type="number" min="1" max="20" className="w-20 ml-2" value={servings} onChange={e=>setServings(Math.max(1,Math.min(20,Number(e.target.value)||1)))}/></label></div><label className="block mt-3"><input type="checkbox" checked={converted} onChange={e=>setConverted(e.target.checked)}/> Convert compatible units</label><ul className="mt-4 space-y-3">{recipe.ingredients.map(i=>{const c=converted?conversions[i.unit]:undefined;const n=i.quantity*servings/recipe.servings*(c?.factor||1);return <li className="border-b border-emerald-900 pb-2" key={i.name}>{Number(n.toFixed(2))} {c?.unit||i.unit} {i.name}</li>})}</ul><p className="text-slate-400 text-sm mt-3">Mass-to-volume conversions depend on ingredient density and are intentionally excluded.</p></section><section className="panel mt-5"><h2 className="text-2xl font-bold mb-4">Instructions</h2><ol className="list-decimal pl-5 space-y-4">{recipe.instructions.map((step,i)=><li key={i}>{step}</li>)}</ol></section></div><aside className="space-y-5"><section className="panel"><h2 className="text-xl font-bold mb-3">Shopping list</h2><p className="text-slate-400 text-sm mb-3">Enter what you already have, then save missing ingredients.</p><textarea className="w-full" rows={3} value={pantry} onChange={e=>setPantry(e.target.value)} placeholder="pasta, tomato"/><button className="primary mt-3 w-full" onClick={addMissing}>Add missing ingredients</button><p className="text-xs mt-3 text-slate-400">Requires sign-in.</p></section><section className="panel"><h2 className="text-xl font-bold mb-3">AI cooking assistant</h2><textarea className="w-full" rows={3} value={question} onChange={e=>setQuestion(e.target.value)} placeholder="What can replace basil?"/><button disabled={!question.trim()||loading} className="primary mt-3 w-full disabled:opacity-50" onClick={ask}>{loading?"Thinking...":"Ask PantryChef"}</button>{answer&&<p className="whitespace-pre-wrap mt-4 text-sm">{answer}</p>}<p className="text-xs text-slate-400 mt-3">Check allergy labels and safe cooking temperatures independently.</p></section>{status&&<p role="status" className="text-amber-300">{status}</p>}</aside></div>}
