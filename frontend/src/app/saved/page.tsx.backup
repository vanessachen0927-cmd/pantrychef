"use client";
import {useEffect,useState} from "react";
import Link from "next/link";
import {api,getRecipes,Recipe} from "@/lib/api";
import {accessToken} from "@/lib/supabase";
type Item={id:number;name:string};
export default function Saved(){const [saved,setSaved]=useState<number[]>([]);const [recipes,setRecipes]=useState<Recipe[]>([]);const [pantry,setPantry]=useState<Item[]>([]);const [name,setName]=useState("");const [status,setStatus]=useState("");async function refresh(){try{const token=await accessToken();const [ids,items,all]=await Promise.all([api("/me/saved",token),api("/me/pantry",token),getRecipes()]);setSaved(ids);setPantry(items);setRecipes(all);setStatus("")}catch(e){setStatus(String(e))}}useEffect(()=>{void refresh()},[]);async function add(){try{await api("/me/pantry",await accessToken(),"POST",{name});setName("");await refresh()}catch(e){setStatus(String(e))}}async function remove(id:number){try{await api(`/me/pantry/${id}`,await accessToken(),"DELETE");await refresh()}catch(e){setStatus(String(e))}}return <div className="grid md:grid-cols-2 gap-6"><section className="panel"><h1 className="text-2xl font-bold mb-4">Saved recipes</h1>{recipes.filter(r=>saved.includes(r.id)).map(r=><p className="mb-3" key={r.id}><Link className="text-amber-400" href={`/recipes/${r.id}`}>{r.title}</Link></p>)}{!saved.length&&<p>No saved recipes yet.</p>}</section><section className="panel"><h2 className="text-2xl font-bold mb-4">My pantry</h2><div className="flex gap-2"><input aria-label="Pantry ingredient" className="min-w-0 flex-1" value={name} onChange={e=>setName(e.target.value)} placeholder="e.g. tomato"/><button className="primary" disabled={!name.trim()} onClick={add}>Add</button></div>{pantry.map(i=><div className="flex justify-between mt-4" key={i.id}>{i.name}<button className="text-amber-400" onClick={()=>remove(i.id)}>Remove</button></div>)}</section>{status&&<p role="status" className="text-amber-300 md:col-span-2">{status}</p>}</div>}
